# Copy to .env (git-ignored) and adjust. Every value is optional for local use.

# Base64 HMAC key for signing access tokens, at least 32 bytes: openssl rand -base64 32
# Without it a random key is used per backend start (sessions survive via silent token refresh).
JWT_SECRET=

# Host port for the web app (http://localhost:8088)
WEB_PORT=8088

# Database password used by both the postgres and backend containers
DB_PASSWORD=jobboard

# Keep true. Set to false only if you open the app over plain http on something other than
# localhost (e.g. a LAN IP), where browsers refuse Secure cookies.
REFRESH_COOKIE_SECURE=true
